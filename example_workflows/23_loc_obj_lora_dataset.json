    "color": "#1a3a5a", "bgcolor": "#1a3a5a"
  },

  "5": {
    "class_type": "LoRADatasetConfig",
    "inputs": {
      "trigger_word": "location_trigger",
      "output_name": "location_trigger",
      "description": "masterpiece, best quality, bridge toons style, cel-shaded, flat colors, detailed scenery, no people",
      "dataset_type": "location",
      "seed": 0,
      "control_after_generate": "randomize"
    },
    "_meta": { "title": "🎛️ EDYTUJ TUTAJ — trigger / opis / output_name / typ (location/object)" },
    "color": "#1a4a5a", "bgcolor": "#1a4a5a"
  },

  "10": {
    "class_type": "PrepImageForClipVision",
    "inputs": {
      "image": ["2", 0],
      "interpolation": "LANCZOS",
      "crop_position": "center",
      "sharpening": 0.0
    },
    "_meta": { "title": "🟣 PrepImage dla CLIP Vision" },
    "color": "#3a1a5a", "bgcolor": "#3a1a5a"
  },
  "11": {
    "class_type": "IPAdapterUnifiedLoader",
    "inputs": { "model": ["1", 0], "preset": "PLUS (high strength)" },
