    "_meta": { "title": "💾 LoRA Caption Saver — PNG + .txt atomicznie" },
    "color": "#4a4a1a", "bgcolor": "#4a4a1a"
  },

  "50": {
    "class_type": "Florence2ModelLoader",
    "inputs": {
      "model": "Florence-2-base",
      "precision": "fp16",
      "attention": "eager"
    },
    "_meta": { "title": "🟡 Florence2 — model loader (fp16)" },
    "color": "#2a1a3a", "bgcolor": "#2a1a3a"
  },
  "51": {
    "class_type": "Florence2Run",
    "inputs": {
      "image": ["40", 0],
      "florence2_model": ["50", 0],
      "text_input": "",
      "task": "more_detailed_caption",
      "fill_mask": true,
      "keep_model_loaded": true,
      "max_new_tokens": 1024,
      "num_beams": 3,
      "do_sample": true,
      "seed": 1
    },
    "_meta": { "title": "🟡 Florence2Run — more_detailed_caption" },
    "color": "#2a1a3a", "bgcolor": "#2a1a3a"
  },
  "52": {
    "class_type": "ShowText|pysssss",
    "inputs": {
      "text": ["41", 1]
    },
    "_meta": { "title": "👁️ Podgląd caption (z trigger word)" },
    "color": "#2a1a3a", "bgcolor": "#2a1a3a"
  }
