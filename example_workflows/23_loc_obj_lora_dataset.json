      "start_at": 0.0, "end_at": 0.75, "embeds_scaling": "V only"
    },
    "_meta": { "title": "🟣 IPA PLUS — wizualny styl lokacji w=0.8 end=0.75" },
    "color": "#3a1a5a", "bgcolor": "#3a1a5a"
  },

  "20": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": ["5", 2]
    },
    "_meta": { "title": "📝 Encode — base description" },
    "color": "#5a4a1a", "bgcolor": "#5a4a1a"
  },
  "21": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": ["5", 1]
    },
    "_meta": { "title": "📝 Encode — varied_prompt (trigger + wildcards)" },
    "color": "#5a4a1a", "bgcolor": "#5a4a1a"
  },
  "23": {
    "class_type": "ConditioningConcat",
    "inputs": {
      "conditioning_to": ["20", 0],
