    "color": "#3a1a5a", "bgcolor": "#3a1a5a"
  },
  "12": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["11", 0], "ipadapter": ["11", 1], "image": ["10", 0],
