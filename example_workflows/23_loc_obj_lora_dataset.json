    "color": "#3a3a1a", "bgcolor": "#3a3a1a"
  },
  "24": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "blurry, low quality, people, persons, characters, humans, watermark, text, deformed, nsfw, anime character in foreground, person standing, 1girl, 1boy"
    },
    "_meta": { "title": "❌ NEGATIVE — brak postaci w scenie" },
    "color": "#4a1a1a", "bgcolor": "#4a1a1a"
  },

  "30": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": ["5", 4],
      "height": ["5", 5],
