{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "Toon/bridgeToonsMix_v80.safetensors" },
    "_meta": { "title": "🔷 Checkpoint — bridgeToonsMix_v80" },
    "color": "#3a1a1a", "bgcolor": "#3a1a1a"
  },

  "2": {
    "class_type": "LoadImage",
    "inputs": { "image": "location_reference.png", "upload": "image" },
