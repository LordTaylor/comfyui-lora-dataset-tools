    "color": "#1a3a5a", "bgcolor": "#1a3a5a"
  },
  "31": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["12", 0],
      "positive": ["23", 0],
      "negative": ["24", 0],
      "latent_image": ["30", 0],
      "seed": 42,
      "control_after_generate": "randomize",
      "steps": 20,
      "cfg": 4.5,
      "sampler_name": "dpmpp_2s_ancestral",
      "scheduler": "karras",
      "denoise": 1.0
    },
    "_meta": { "title": "🟠 KSampler — 20 steps / cfg=4.5 / seed randomize" },
    "color": "#1a5a1a", "bgcolor": "#1a5a1a"
  },

  "40": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["31", 0], "vae": ["1", 2] },
